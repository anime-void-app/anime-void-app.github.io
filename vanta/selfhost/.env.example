# Generate both secrets independently; do not commit your actual .env!
# python -c "import secrets;print(secrets.token_urlsafe(40))"
VANTA_ACCESS_TOKEN=CHANGE_ME_TO_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SEARXNG_SECRET=CHANGE_ME_TO_ANOTHER_UNIQUE_RANDOM_SECRET
OLLAMA_URL=http://ollama:11434
SEARXNG_URL=http://searxng:8080
# Only use the following model IDs after downloading their weights.
MODEL_FAST=qwen3:4b
MODEL_SMART=qwen3:4b
MODEL_DEEP=qwen3:4b
MODEL_MAX=qwen3:4b
# Maximum sources used per web search, NOT searches/day.
SEARCH_RESULTS=10
# Simultaneous generations limited by your actual GPU/RAM.
MAX_CONCURRENT=1

# For 24/7 hosting on your own GPU VM using a Cloudflare Tunnel:
# TUNNEL_TOKEN=PASTE_YOUR_TUNNEL_TOKEN_HERE
# VANTA_ALLOWED_ORIGIN=https://vanta.yourdomain.com
